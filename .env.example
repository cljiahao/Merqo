# Shared Supabase project (arch-v2 §2): use the SAME values as qkit's project.
# merqo's tables live in the `merqo` schema; each kit owns its own schema
# (qkit's is `qkit`, not `public`).
# `merqo` must be added to the project's exposed API schemas (dashboard → API).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Shared-session SSO across *.merqo.io kits — leave unset in dev/preview
# (they don't run on merqo.io; setting this there breaks login instead of
# just failing to share it). Set to .merqo.io in Vercel Production only.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Live kit domains (src/lib/kits.ts). Optional — each falls back to its
# -sg.vercel.app default if unset. IMPORTANT for shared-session SSO above:
# the -sg.vercel.app defaults are NOT on the .merqo.io domain, so the shared
# cookie is never sent there — set these to each kit's https://<kit>.merqo.io
# host in Vercel Production, or the hub's own launch buttons will bounce
# vendors into a login loop instead of a shared session.
NEXT_PUBLIC_QKIT_URL=
NEXT_PUBLIC_LOOPKIT_URL=
NEXT_PUBLIC_PAYKIT_URL=

# Customer Telegram connect (Phase B+D): merqo's OWN third Telegram bot —
# a separate BotFather registration from qkit's and loopkit's own Phase A
# vendor-alert bots, its own token. TELEGRAM_BOT_TOKEN/TELEGRAM_BOT_USERNAME:
# create a bot via @BotFather, copy the token it gives you and the
# username you set. TELEGRAM_WEBHOOK_SECRET: any random string you choose
# yourself — configured on the one-time `setWebhook` call (see
# docs/DEPLOY.md), never sent to Telegram elsewhere.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Shared-bearer secret for the two /api/merqo/* endpoints qkit and loopkit
# call INTO merqo (customer-connect-token, notify-customer) — the first
# kit → merqo HTTP direction in this codebase. Same simple
# one-value-known-by-everyone pattern MERQO_METRICS_SECRET already uses in
# the opposite direction, not a per-kit-unique key system. The SAME value
# must also be set as each participating kit's own env var for this flow.
MERQO_CUSTOMER_SECRET=
